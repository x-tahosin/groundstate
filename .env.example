# GroundState — Production Environment Variables
# NEVER commit .env with real secrets to public repositories!

# DigitalOcean Serverless Inference Credentials
# Obtain from: https://cloud.digitalocean.com/gen-ai
DIGITALOCEAN_API_KEY=your_digitalocean_serverless_api_key_here

# DigitalOcean Serverless Inference Base Endpoint
# Official endpoint: https://inference.do-ai.run/v1 or https://inference.digitalocean.com/v1
DIGITALOCEAN_INFERENCE_ENDPOINT=https://inference.do-ai.run/v1

# Selected model candidate:
# Supported models:
# - meta-llama/Meta-Llama-3.1-8B-Instruct (Recommended for low-latency JSON structured routines)
# - mistralai/Mistral-7B-Instruct-v0.2
# - digitalocean/gemma-4-31B-it (Candidate model)
DIGITALOCEAN_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Server port (default 4500 local, 8080 in DigitalOcean App Platform)
PORT=4500
